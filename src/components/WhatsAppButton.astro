---
const waNumber = "51984498555";
const waLink = `https://wa.me/${waNumber}`;
---

<a
  href={waLink}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Cotizar por WhatsApp"
  class="nk-bubble"
>
  <div class="nk-bubble-icon-container">
    <svg
      class="nk-bubble-icon"
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
    >
      <path
        d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
      ></path>
    </svg>
    <span class="nk-bubble-dot" aria-hidden="true"></span>
  </div>

  <div class="nk-bubble-label" aria-hidden="true">
    <span class="nk-bubble-title">Respuesta rápida</span>
    <span class="nk-bubble-text">Cotizar por WhatsApp</span>
  </div>
</a>

<style>
  .nk-bubble {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 9999;
    width: 60px;
    height: 60px;
    background: linear-gradient(135deg, #25d366 0%, #1ebe5d 100%);
    border-radius: 30px;
    display: flex;
    align-items: center;
    overflow: hidden;
    text-decoration: none;
    color: #ffffff;
    cursor: pointer;
    box-shadow: 0 8px 24px rgba(37, 211, 102, 0.4);
    animation: nk-pulse 2.8s ease-in-out infinite;
    transition:
      width 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      border-radius 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.3s ease;
    -webkit-font-smoothing: antialiased;
  }

  .nk-bubble:focus-visible {
    outline: 3px solid #ffffff;
    outline-offset: 2px;
  }

  .nk-bubble-icon-container {
    position: relative;
    min-width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .nk-bubble-icon {
    width: 30px;
    height: 30px;
    transition: transform 0.3s ease;
  }

  .nk-bubble-dot {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 10px;
    height: 10px;
    background-color: #ffffff;
    border: 2px solid #1ebe5d;
    border-radius: 50%;
    z-index: 2;
    animation: nk-dot-blink 2s ease-in-out infinite;
  }

  .nk-bubble-label {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2px;
    width: 0;
    padding-right: 0;
    overflow: hidden;
    white-space: nowrap;
    opacity: 0;
    text-align: left;
    transition:
      width 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.25s ease 0.05s,
      padding 0.4s ease;
  }

  .nk-bubble-title {
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    font-weight: 600;
    opacity: 0.85;
  }

  .nk-bubble-text {
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: -0.2px;
  }

  @keyframes nk-pulse {
    0% {
      box-shadow:
        0 0 0 0 rgba(37, 211, 102, 0.4),
        0 8px 24px rgba(37, 211, 102, 0.4);
    }
    70% {
      box-shadow:
        0 0 0 16px rgba(37, 211, 102, 0),
        0 8px 24px rgba(37, 211, 102, 0.4);
    }
    100% {
      box-shadow:
        0 0 0 0 rgba(37, 211, 102, 0),
        0 8px 24px rgba(37, 211, 102, 0.4);
    }
  }

  @keyframes nk-dot-blink {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.25);
    }
  }

  @media (max-width: 1023.98px) {
    .nk-bubble-label {
      display: none;
    }
  }

  @media (min-width: 1024px) {
    .nk-bubble:hover {
      width: 235px;
      border-radius: 30px;
      animation: none;
      box-shadow: 0 10px 28px rgba(37, 211, 102, 0.45);
    }

    .nk-bubble:hover .nk-bubble-icon {
      transform: scale(1.05);
    }

    .nk-bubble:hover .nk-bubble-label {
      width: 175px;
      opacity: 1;
      padding-right: 16px;
    }
  }
</style>
