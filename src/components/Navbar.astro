---
import {
  Astronav,
  MenuItems,
  MenuIcon,
  Dropdown,
  DropdownItems,
  StickyHeader,
} from "astro-navbar";
import { Image } from "astro:assets";

// Definir la prop para la página activa
const { activePage = "inicio" } = Astro.props;
---

<StickyHeader
  class="navbar-wrapper sticky top-0 z-[1000] transition-all duration-300"
  scrollY={50}
  activeClass="shadow-lg bg-white/95 backdrop-blur-md"
  defaultClass="bg-white"
>
  <div class="container mx-auto">
    <Astronav closeOnClick>
      <nav
        class="flex flex-col lg:flex-row justify-between items-center p-4 lg:px-8"
      >
        <div class="flex w-full lg:w-auto justify-between items-center">
          <a
            href="/"
            class="logo-container"
            aria-label="Ir al inicio de Tuboflex Perú"
          >
            <Image
              src="/logo.png"
              alt="Logo Tuboflex Perú"
              width={160}
              height={80}
              loading="eager"
              class="logo-img"
            />
          </a>

          <div class="block lg:hidden">
            <MenuIcon class="w-8 h-8 text-[#005daa]" />
          </div>
        </div>

        <MenuItems class="hidden lg:flex w-full lg:w-auto mt-4 lg:mt-0">
          <ul
            class="flex flex-col lg:flex-row lg:gap-8 items-start lg:items-center w-full"
            role="menubar"
          >
            <li>
              <a
                href="/"
                class={`nav-item ${activePage === "inicio" ? "active" : ""}`}
                aria-label="Ir al inicio de Tuboflex Perú">INICIO</a
              >
            </li>

            <li role="none">
              <Dropdown class="group">
                <button
                  class={`nav-item flex items-center gap-1 ${activePage === "nosotros" ? "active" : ""}`}
                  aria-haspopup="true"
                  role="menuitem"
                >
                  <span>NOSOTROS</span>
                  <svg
                    class="w-3 h-3 transition-transform group-open:rotate-180"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                    ><path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="3"
                      d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path></svg
                  >
                </button>
                <DropdownItems class="relative lg:absolute">
                  <div
                    class="dropdown-card"
                    role="menu"
                    aria-label="Submenu Nosotros"
                  >
                    <a href="/nosotros#quienes-somos" role="menuitem"
                      >¿Quiénes Somos?</a
                    >
                    <a href="/nosotros#mision-vision" role="menuitem"
                      >Misión y Visión</a
                    >
                    <a href="/politica-de-calidad" role="menuitem"
                      >Política de Calidad</a
                    >
                    <!--
                    <a href="/nosotros#infraestructura">Infraestructura</a>
                   
                   -->
                  </div>
                </DropdownItems>
              </Dropdown>
            </li>

            <li role="none">
              <Dropdown class="group">
                <button
                  class={`nav-item flex items-center gap-1 ${activePage === "productos" ? "active" : ""}`}
                  aria-haspopup="true"
                  role="menuitem"
                >
                  <span>PRODUCTOS</span>
                  <svg
                    class="w-3 h-3 transition-transform group-open:rotate-180"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                    ><path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="3"
                      d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path></svg
                  >
                </button>
                <DropdownItems class="relative lg:absolute">
                  <div
                    class="dropdown-card products-dropdown-card"
                    role="menu"
                    aria-label="Submenu Productos"
                  >
                    <div class="products-dropdown-column">
                      <span class="products-dropdown-title"
                        >Tubos Colapsibles de Aluminio</span
                      >
                      <a href="/products" role="menuitem">Tubo Ø 13.5</a>
                      <a href="/products" role="menuitem">Tubo Ø 16.0</a>
                      <a href="/products" role="menuitem">Tubo Ø 19.0</a>
                      <a href="/products" role="menuitem">Tubo Ø 22.0</a>
                    </div>
                    <div class="products-dropdown-column">
                      <span class="products-dropdown-title"
                        >Tubos Colapsibles de Plástico</span
                      >
                      <a href="/products" role="menuitem">Tubo Ø 35</a>
                      <a href="/products" role="menuitem">Tubo Ø 40</a>
                      <a href="/products" role="menuitem">Tubo Ø 50</a>
                    </div>
                    <div class="products-dropdown-column">
                      <span class="products-dropdown-title"
                        >Envases de Aluminio</span
                      >
                      <a href="/products" role="menuitem"
                        >10.4 onz. - 310 ml. sleek</a
                      >
                      <a href="/products" role="menuitem"
                        >12 onz. - 355 ml. standard</a
                      >
                      <a href="/products" role="menuitem"
                        >12 onz. - 355 ml. sleek</a
                      >
                      <a href="/products" role="menuitem"
                        >16 onz. - 473 ml. standard</a
                      >
                    </div>
                  </div>
                </DropdownItems>
              </Dropdown>
            </li>

            <li>
              <a
                href="/advantages"
                class={`nav-item ${activePage === "ventajas" ? "active" : ""}`}
                >VENTAJAS</a
              >
            </li>
            <li>
              <a
                href="/trabaja-con-nosotros"
                class={`nav-item ${activePage === "trabaja" ? "active" : ""}`}
                >TRABAJA CON NOSOTROS</a
              >
            </li>

            <li class="lg:hidden w-full mt-4">
              <a href="/contacto" class="mobile-contact-btn">CONTÁCTANOS</a>
            </li>
          </ul>
        </MenuItems>

        <div class="hidden lg:flex items-center gap-6">
          <!-- Botones de Contacto y Idioma 
         <div class="lang-selector">🌐 ES</div>
        -->
          <a href="/contacto" class="contact-btn">CONTÁCTANOS</a>
        </div>
      </nav>
    </Astronav>
  </div>
</StickyHeader>

<style>
  /* Colores e Identidad Tuboflex */
  :root {
    --primary-blue: #005daa;
    --brand-red: #e31e24;
    --text-dark: #333333;
  }

  /* Estilos base */
  .logo-img {
    height: 80px;
    width: auto;
  }

  .nav-item {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-dark);
    text-decoration: none;
    transition: all 0.3s ease;
    padding: 0.5rem 0;
  }

  .nav-item:hover,
  .nav-item.active {
    color: var(--primary-blue);
  }

  /* Dropdown Card */
  .dropdown-card {
    background: white;
    border-radius: 8px;
    padding: 0.5rem 0;
    min-width: 200px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
    display: flex;
    flex-direction: column;
    z-index: 50;
  }

  .dropdown-toggle {
    padding-top: 0.5rem;
  }

  .dropdown-card a {
    padding: 0.75rem 1.5rem;
    font-size: 0.85rem;
    color: var(--text-dark);
    text-decoration: none;
    transition: background 0.2s;
  }

  .dropdown-card a:hover {
    background: #f8f9fa;
    color: var(--primary-blue);
  }

  /* Dropdown de Productos con 3 columnas */
  .products-dropdown-card {
    min-width: 680px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    padding: 1rem 0;
  }

  .products-dropdown-column {
    display: flex;
    flex-direction: column;
    padding: 0 1.5rem;
  }

  .products-dropdown-column:not(:last-child) {
    border-right: 1px solid #e9ecef;
  }

  .products-dropdown-title {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--primary-blue);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.5rem 0 0.75rem;
    border-bottom: 2px solid #e9ecef;
    margin-bottom: 0.25rem;
  }

  .products-dropdown-column a {
    padding: 0.6rem 0;
  }

  @media (max-width: 1023px) {
    .products-dropdown-card {
      min-width: 0;
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }

    .products-dropdown-column:not(:last-child) {
      border-right: none;
      border-bottom: 1px solid #e9ecef;
      padding-bottom: 0.75rem;
    }
  }

  /* Botones de Contacto */
  .contact-btn {
    background: var(--primary-blue);
    color: white;
    padding: 10px 24px;
    border-radius: 50px;
    font-weight: 700;
    font-size: 0.8rem;
    text-decoration: none;
    transition:
      transform 0.2s,
      background 0.2s;
  }

  .contact-btn:hover {
    background: #004a87;
    transform: translateY(-2px);
  }

  .mobile-contact-btn {
    display: block;
    background: var(--primary-blue);
    color: white;
    text-align: center;
    padding: 12px;
    border-radius: 8px;
    font-weight: 700;
    text-decoration: none;
  }

  .lang-selector {
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
  }

  /* Estilos específicos para que astro-navbar funcione sin Tailwind si no lo usas */
  :global(.hidden) {
    display: none;
  }
  @media (min-width: 1024px) {
    :global(.lg\:flex) {
      display: flex;
    }
  }
</style>

<script>
  const desktop = window.matchMedia("(min-width: 1024px)");
  let openMenu = null;

  function openDropdown(menu) {
    const toggle = menu.querySelector(".dropdown-toggle");
    menu.classList.add("open");
    menu.setAttribute("open", "");
    menu.setAttribute("aria-expanded", "true");
    toggle?.classList.remove("hidden");
    toggle?.setAttribute("aria-expanded", "true");
  }

  function closeDropdown(menu) {
    const toggle = menu.querySelector(".dropdown-toggle");
    menu.classList.remove("open");
    menu.removeAttribute("open");
    menu.setAttribute("aria-expanded", "false");
    toggle?.classList.add("hidden");
    toggle?.setAttribute("aria-expanded", "false");
  }

  function outermostDropdown(el) {
    let current = el.closest(".astronav-dropdown");
    let parent = current?.parentElement?.closest(".astronav-dropdown");
    while (parent) {
      current = parent;
      parent = current.parentElement?.closest(".astronav-dropdown");
    }
    return current;
  }

  document.addEventListener("mouseover", (e) => {
    if (!desktop.matches) return;
    const menu = outermostDropdown(e.target);
    if (menu) {
      if (openMenu && openMenu !== menu) closeDropdown(openMenu);
      openMenu = menu;
      openDropdown(menu);
    } else if (openMenu) {
      closeDropdown(openMenu);
      openMenu = null;
    }
  });
</script>
